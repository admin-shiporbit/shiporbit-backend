######################
## Spring Boot / secrets  (IMPORTANT)
######################
# Never commit real credentials. Keep a committed application.yml with
# safe/dev defaults, but ignore any local/secret override files:
application-local.yml
application-local.yaml
application-local.properties
application-secret*.yml
application-secret*.properties
.env
.env.*

